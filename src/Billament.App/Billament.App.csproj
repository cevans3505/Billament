<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Billament.Core\Billament.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Billament</AssemblyName>
    <RootNamespace>Billament.App</RootNamespace>
    <Product>Billament</Product>
    <Version>3.7.0</Version>
    <!-- Application.ThemeMode (Fluent dark theme) is marked experimental in WPF. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>Assets\Billament.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon.xaml is the drawing tools\Make-Icon.ps1 renders into Billament.ico; it is not app UI. -->
    <Page Remove="Assets\Icon.xaml" />
    <None Include="Assets\Icon.xaml" />
    <Resource Include="Assets\Billament.ico" />
  </ItemGroup>

</Project>
